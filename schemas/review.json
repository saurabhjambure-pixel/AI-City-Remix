{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneVisualReview",
  "type": "object",
  "properties": {
    "pass": {"type": "boolean"},
    "round": {"type": "integer"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame": {"type": "string"},
          "problem": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["high", "low"]
          }
        },
        "required": ["frame", "problem", "severity"]
      }
    },
    "prompt_additions": {"type": "string"}
  },
  "required": ["pass", "round", "issues", "prompt_additions"]
}
