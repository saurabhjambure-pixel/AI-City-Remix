{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JudgeVerdicts",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {"type": "string"},
      "supported": {"type": "boolean"},
      "reason": {"type": "string"},
      "corrected_claim": {"type": ["string", "null"]},
      "supporting_quotes": {"type": "array", "items": {"type": "integer", "minimum": 0}}
    },
    "required": ["id", "supported", "reason", "supporting_quotes"]
  }
}
