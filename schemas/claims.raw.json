{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawClaimsList",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {"type": "string"},
      "cluster": {
        "type": "string",
        "enum": ["geography", "origins", "maratha", "peshwa", "british", "education", "industry", "it_growth", "culture"]
      },
      "claim": {"type": "string"},
      "kind": {
        "type": "string",
        "enum": ["event", "date", "number", "place", "name", "culture"]
      },
      "value": {"type": ["string", "number", "null"]},
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "domain": {"type": "string"},
            "quote": {"type": "string"},
            "cache": {"type": "string"}
          },
          "required": ["url", "quote"]
        }
      }
    },
    "required": ["id", "cluster", "claim", "kind", "sources"]
  }
}
